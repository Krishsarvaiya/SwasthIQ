# SwasthIQ Public Beta Website Configuration

# Google Apps Script Web App Endpoint for Feedback Collection
VITE_FEEDBACK_ENDPOINT=https://script.google.com/macros/s/AKfycby_placeholder/exec

# Android Beta APK Direct Download URL (GitHub Releases latest asset)
# This URL uses GitHub's latest-release redirect mechanism.
# When you publish a new GitHub Release with the same asset filename (SwasthIQ.apk),
# this URL automatically points to the newest release.
VITE_ANDROID_BETA_URL=https://github.com/Krishsarvaiya/SwasthIQ/releases/latest/download/SwasthIQ.apk

# SHA-256 of the APK in the latest release. Update it every release (sha256sum SwasthIQ.apk).
VITE_APK_SHA256=71c5d8252b43389de73b9dd51bf569b6fdc78ba7b43b6bdd7bda964d36412b64
